{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reinframe.dev/schemas/review_decision.json",
  "title": "ReviewDecision",
  "type": "object",
  "required": [
    "decision_id",
    "request_id",
    "reviewer_role",
    "tunnel_confidence",
    "classification",
    "rationale",
    "tokens_used",
    "decided_at"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_role": {
      "type": "string",
      "minLength": 1
    },
    "tunnel_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "classification": {
      "type": "string",
      "enum": [
        "NORMAL_PROGRESS",
        "TUNNEL_VISION",
        "SCOPE_DRIFT",
        "REPEATED_ERROR"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "suggested_advice": {
      "type": "string"
    },
    "tokens_used": {
      "type": "integer",
      "minimum": 0
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
