{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reinframe.dev/schemas/error_fingerprint.json",
  "title": "ErrorFingerprint",
  "type": "object",
  "required": [
    "fingerprint_id",
    "raw_error",
    "normalized_text",
    "occurrence_count",
    "first_observed_at",
    "last_observed_at"
  ],
  "properties": {
    "fingerprint_id": {
      "type": "string",
      "minLength": 1
    },
    "raw_error": {
      "type": "string",
      "minLength": 1
    },
    "normalized_text": {
      "type": "string",
      "minLength": 1
    },
    "occurrence_count": {
      "type": "integer",
      "minimum": 1
    },
    "first_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_observed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
