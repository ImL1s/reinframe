{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reinframe.dev/schemas/capability_manifest.json",
  "title": "CapabilityManifest",
  "type": "object",
  "required": [
    "agent_id",
    "version",
    "integration_level",
    "supports_event_stream",
    "supports_tool_inspection",
    "supports_diff_inspection",
    "supports_cost_tracking",
    "supports_hooks",
    "supports_headless",
    "supports_cli_control",
    "supports_pause",
    "supports_cancel",
    "supports_resume",
    "supports_checkpoint",
    "supports_rollback",
    "supports_mcp",
    "supports_subagents",
    "supports_extensions",
    "supports_switch_model",
    "supports_custom_provider",
    "supports_openai_compat",
    "supports_local_models",
    "supports_sdk",
    "supports_advice_delivery",
    "supports_context_injection",
    "supports_tool_gate",
    "supports_turn_boundary",
    "supports_intervention_ack"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "integration_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "supports_event_stream": {
      "type": "boolean"
    },
    "supports_tool_inspection": {
      "type": "boolean"
    },
    "supports_diff_inspection": {
      "type": "boolean"
    },
    "supports_cost_tracking": {
      "type": "boolean"
    },
    "supports_hooks": {
      "type": "boolean"
    },
    "supports_headless": {
      "type": "boolean"
    },
    "supports_cli_control": {
      "type": "boolean"
    },
    "supports_pause": {
      "type": "boolean",
      "description": "Harness-native pause only. OS SIGSTOP/SIGTSTP is NOT CapPause (#72)."
    },
    "supports_cancel": {
      "type": "boolean"
    },
    "supports_resume": {
      "type": "boolean"
    },
    "supports_checkpoint": {
      "type": "boolean"
    },
    "supports_rollback": {
      "type": "boolean"
    },
    "supports_mcp": {
      "type": "boolean"
    },
    "supports_subagents": {
      "type": "boolean"
    },
    "supports_extensions": {
      "type": "boolean"
    },
    "supports_switch_model": {
      "type": "boolean"
    },
    "supports_custom_provider": {
      "type": "boolean"
    },
    "supports_openai_compat": {
      "type": "boolean"
    },
    "supports_local_models": {
      "type": "boolean"
    },
    "supports_sdk": {
      "type": "boolean"
    },
    "supports_advice_delivery": {
      "type": "boolean",
      "description": "Can deliver advisory prompts into the agent turn (CapAdviceDelivery; required for Level 1)."
    },
    "supports_context_injection": {
      "type": "boolean",
      "description": "Can inject supervisor context into agent input (CapContextInjection)."
    },
    "supports_tool_gate": {
      "type": "boolean",
      "description": "Can gate/defer/deny tool calls via hooks/pre-tool (CapToolGate)."
    },
    "supports_turn_boundary": {
      "type": "boolean",
      "description": "Can observe or enforce turn/message boundaries (CapTurnBoundary)."
    },
    "supports_intervention_ack": {
      "type": "boolean",
      "description": "Can acknowledge intervention delivery/ACK lifecycle (CapInterventionAck)."
    }
  },
  "additionalProperties": false
}
