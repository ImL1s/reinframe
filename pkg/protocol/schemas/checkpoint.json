{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reinframe.dev/schemas/checkpoint.json",
  "title": "Checkpoint",
  "type": "object",
  "required": [
    "checkpoint_id",
    "session_id",
    "git_commit_hash",
    "branch_name",
    "description",
    "passing_test_count",
    "created_at"
  ],
  "properties": {
    "checkpoint_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "git_commit_hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "branch_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "passing_test_count": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
