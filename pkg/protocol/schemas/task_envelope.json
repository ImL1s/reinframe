{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reinframe.dev/schemas/task_envelope.json",
  "title": "TaskEnvelope",
  "type": "object",
  "required": [
    "task_id",
    "session_id",
    "prompt",
    "max_depth",
    "timeout_seconds",
    "created_at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "scope_whitelist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
