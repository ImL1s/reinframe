{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reinframe.dev/schemas/intervention.json",
  "title": "Intervention",
  "type": "object",
  "required": [
    "intervention_id",
    "session_id",
    "level",
    "action_type",
    "status",
    "executed_at"
  ],
  "properties": {
    "intervention_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "action_type": {
      "type": "string",
      "enum": [
        "ZOOM_OUT_PROMPT",
        "PAUSE_PROCESS",
        "CANCEL_ACTION",
        "GIT_ROLLBACK",
        "TERMINATE_SESSION",
        "SWITCH_MODEL",
        "ESCALATE_TO_HUMAN"
      ]
    },
    "advice_prompt": {
      "type": "string"
    },
    "target_checkpoint_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "DELIVERED",
        "EXECUTED",
        "FAILED",
        "SUPPRESSED",
        "ACKED",
        "EXPIRED"
      ]
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional absolute expiry for the intervention delivery window."
    },
    "priority": {
      "type": "integer",
      "description": "Optional delivery priority; higher values are more urgent. Zero/omit is default."
    },
    "delivery_mode_hint": {
      "type": "string",
      "description": "Optional adapter hint for how to deliver (e.g. inject, prompt, hook)."
    },
    "requires_ack": {
      "type": "boolean",
      "description": "When true, delivery must be acknowledged (CapInterventionAck path)."
    },
    "ack_status": {
      "type": "string",
      "enum": [
        "NONE",
        "PENDING",
        "ACKED",
        "NACKED",
        "EXPIRED"
      ],
      "description": "Enum-like ACK lifecycle status; omit or NONE when unused."
    },
    "acked_at": {
      "type": "string",
      "format": "date-time"
    },
    "safe_boundary": {
      "type": "string",
      "description": "Optional safe turn/tool boundary identifier for deferred delivery."
    },
    "fingerprint": {
      "type": "string",
      "description": "Optional stable fingerprint for dedupe of identical interventions."
    },
    "parent_assessment_id": {
      "type": "string",
      "description": "Optional link to the TunnelAssessment that triggered this intervention."
    }
  },
  "additionalProperties": false
}
