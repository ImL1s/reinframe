{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reinframe.dev/schemas/assumption.json",
  "title": "Assumption",
  "type": "object",
  "required": [
    "assumption_id",
    "description",
    "is_verified"
  ],
  "properties": {
    "assumption_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "is_verified": {
      "type": "boolean"
    },
    "verification_method": {
      "type": "string"
    },
    "audit_verdict": {
      "type": "string",
      "enum": [
        "VALIDATED",
        "UNSUBSTANTIATED",
        "CONTRADICTED"
      ]
    }
  },
  "additionalProperties": false
}
